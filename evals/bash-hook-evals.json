{
  "hook": "check-bash-read",
  "cases": [
    { "name": "cat small file allowed", "file_lines": 50, "command": "cat {file}", "expect": "allow" },
    { "name": "cat large file blocked", "file_lines": 500, "command": "cat {file}", "expect": "deny" },
    { "name": "head large file blocked", "file_lines": 500, "command": "head {file}", "expect": "deny" },
    { "name": "tail large file blocked", "file_lines": 500, "command": "tail {file}", "expect": "deny" },
    { "name": "less large file blocked", "file_lines": 500, "command": "less {file}", "expect": "deny" },
    { "name": "more large file blocked", "file_lines": 500, "command": "more {file}", "expect": "deny" },
    { "name": "cat with flags large file blocked", "file_lines": 500, "command": "cat -n {file}", "expect": "deny" },
    { "name": "head with numeric flag large file blocked", "file_lines": 500, "command": "head -100 {file}", "expect": "deny" },
    { "name": "piped cat allowed (targeted read)", "file_lines": 500, "command": "cat {file} | grep foo", "expect": "allow" },
    { "name": "redirected cat allowed (not reading into context)", "file_lines": 500, "command": "cat {file} > /tmp/out", "expect": "allow" },
    { "name": "git status allowed", "file_lines": null, "command": "git status", "expect": "allow" },
    { "name": "grep allowed", "file_lines": 500, "command": "grep foo {file}", "expect": "allow" },
    { "name": "empty command allowed", "file_lines": null, "command": "", "expect": "allow" },
    { "name": "cat nonexistent file allowed", "file_lines": null, "command": "cat /nonexistent/path", "expect": "allow" },
    { "name": "cat quoted path large file blocked", "file_lines": 500, "command": "cat \"{file}\"", "expect": "deny" },
    { "name": "custom threshold via env", "file_lines": 40, "command": "cat {file}", "env": { "RELAY_MIN_LINES": "10" }, "expect": "deny" },
    { "name": "block reason mentions bulk-reader", "file_lines": 500, "command": "cat {file}", "expect": "deny", "reason_contains": "bulk-reader" },
    { "name": "sed -n range on large file blocked", "file_lines": 500, "command": "sed -n '1,350p' {file}", "expect": "deny" },
    { "name": "sed -n range on small file allowed", "file_lines": 50, "command": "sed -n '1,20p' {file}", "expect": "allow" },
    { "name": "sed -i on large file allowed (edit, not read)", "file_lines": 500, "command": "sed -i '' 's/1/2/' {file}", "expect": "allow" },
    { "name": "sed --in-place on large file allowed (edit, not read)", "file_lines": 500, "command": "sed --in-place 's/1/2/' {file}", "expect": "allow" },
    { "name": "sed quoted path large file blocked", "file_lines": 500, "command": "sed -n '1,350p' \"{file}\"", "expect": "deny" }
  ]
}
