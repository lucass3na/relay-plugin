#!/bin/bash
# Block Bash commands that read large files, redirect to the bulk-reader skill
# Catches cat/head/tail/less/more/sed that bypass the Read hook

. "$(cd "$(dirname "$0")" && pwd)/lib/hook.sh"

input=$(cat)

command=$(echo "$input" | jq -r '.tool_input.command // empty')
[ -z "$command" ] && exit 0

# Skip piped commands (cat file | grep) — those are targeted reads
echo "$command" | grep -qE '\|' && exit 0

# Skip redirections (cat file > out) — not a read-into-context operation
echo "$command" | grep -qE '>' && exit 0

# Extract file path from read commands, stripping flags (e.g. cat -n, head -100)
file_path=""
if echo "$command" | grep -qE '^sed ' && ! echo "$command" | grep -qE ' (-i|--in-place)'; then
  # sed prints its input (sed -n '1,350p' file), the file is the last argument
  file_path=$(echo "$command" | awk '{ print $NF }' | tr -d '"'"'")
elif echo "$command" | grep -qE '^(cat|head|tail|less|more) '; then
  # Remove the command name, then strip any flags (-n, -100, --number, etc.)
  args=$(echo "$command" | sed -E 's/^(cat|head|tail|less|more) +//')
  for arg in $args; do
    case "$arg" in
      -*) continue ;;
      *)  file_path=$(echo "$arg" | tr -d '"'"'"); break ;;
    esac
  done
fi

[ -z "$file_path" ] && exit 0
[ ! -f "$file_path" ] && exit 0

lines=$(relay_line_count "$file_path")
if [ "$lines" -gt "$MIN_LINES" ]; then
  relay_block "File is ${lines} lines (threshold: ${MIN_LINES}). Delegate this read with the relay:bulk-reader skill instead of cat/head/tail/sed. For a specific section you need to edit, use Read with offset/limit."
fi
