{
  "hook": "check-file-size",
  "cases": [
    { "name": "small file allowed", "file_lines": 50, "tool_input": {}, "expect": "allow" },
    { "name": "large file blocked", "file_lines": 500, "tool_input": {}, "expect": "deny" },
    { "name": "exactly at threshold allowed", "file_lines": 350, "tool_input": {}, "expect": "allow" },
    { "name": "one over threshold blocked", "file_lines": 351, "tool_input": {}, "expect": "deny" },
    { "name": "large file with offset only blocked (reads to end)", "file_lines": 500, "tool_input": { "offset": 100 }, "expect": "deny" },
    { "name": "large file with limit allowed", "file_lines": 500, "tool_input": { "limit": 50 }, "expect": "allow" },
    { "name": "large file with offset and limit allowed", "file_lines": 500, "tool_input": { "offset": 10, "limit": 20 }, "expect": "allow" },
    { "name": "nonexistent file allowed", "file_lines": null, "tool_input": {}, "expect": "allow" },
    { "name": "empty file_path allowed", "file_lines": 500, "tool_input": { "file_path": "" }, "expect": "allow" },
    { "name": "custom threshold via env allows under it", "file_lines": 100, "tool_input": {}, "env": { "RELAY_MIN_LINES": "50" }, "expect": "deny" },
    { "name": "custom threshold via env blocks over it", "file_lines": 40, "tool_input": {}, "env": { "RELAY_MIN_LINES": "50" }, "expect": "allow" },
    { "name": "invalid env threshold falls back to default (small)", "file_lines": 100, "tool_input": {}, "env": { "RELAY_MIN_LINES": "notanumber" }, "expect": "allow" },
    { "name": "invalid env threshold falls back to default (large)", "file_lines": 500, "tool_input": {}, "env": { "RELAY_MIN_LINES": "notanumber" }, "expect": "deny" },
    { "name": "zero offset without limit blocked", "file_lines": 500, "tool_input": { "offset": 0 }, "expect": "deny" },
    { "name": "one line file allowed", "file_lines": 1, "tool_input": {}, "expect": "allow" },
    { "name": "very large file blocked", "file_lines": 10000, "tool_input": {}, "expect": "deny" },
    { "name": "block reason mentions bulk-reader", "file_lines": 500, "tool_input": {}, "expect": "deny", "reason_contains": "bulk-reader" },
    { "name": "limit at threshold allowed", "file_lines": 500, "tool_input": { "limit": 350 }, "expect": "allow" },
    { "name": "limit over threshold blocked", "file_lines": 500, "tool_input": { "offset": 1, "limit": 400 }, "expect": "deny" },
    { "name": "repeated small targeted reads allowed", "file_lines": 500, "tool_input": { "offset": 100, "limit": 50 }, "repeat": 7, "expect": "allow" },
    { "name": "chunked reads blocked once budget is spent", "file_lines": 900, "tool_input": { "offset": 1, "limit": 350 }, "repeat": 2, "expect": "deny" },
    { "name": "chunked reads of 200 blocked on second chunk", "file_lines": 900, "tool_input": { "offset": 1, "limit": 200 }, "repeat": 2, "expect": "deny", "reason_contains": "bulk-reader" },
    { "name": "large binary file allowed (images, PDFs)", "file_lines": 1000, "binary": true, "tool_input": {}, "expect": "allow" },
    { "name": "budget respects custom threshold", "file_lines": 100, "tool_input": { "limit": 30 }, "repeat": 2, "env": { "RELAY_MIN_LINES": "50" }, "expect": "deny" }
  ]
}
